<vertical id="beatleader-menu-root"
          preferred-width="112"
          preferred-height="136"
          child-control-height="false"
          child-control-width="false"
          child-expand-height="false"
          child-expand-width="false"
          child-align="UpperCenter"
          spacing="1.5">

    <horizontal id="header-row"
                ignore-layout="true"
                preferred-width="112"
                preferred-height="10"
                child-control-width="false"
                child-control-height="false"
                child-expand-width="false"
                child-expand-height="false"
                child-align="MiddleCenter">
        <image id="beatleader-provider-logo"
               src="BeatLocator.Assets.bl_logo.png"
               ignore-layout="true"
               anchor-min="0.5 0.5"
               anchor-max="0.5 0.5"
               anchored-position="-33.5 0"
               size-delta="6.7 6.7"
               preserve-aspect="true" />
        <image id="beatlocator-logo"
               src="BeatLocator.Assets.logo.png"
               ignore-layout="true"
               anchor-min="0.5 0.5"
               anchor-max="0.5 0.5"
               anchored-position="4.5 0"
               size-delta="63.35 7"
               preserve-aspect="true" />
        <button id="exit-button"
                text=""
                on-click="exitPressed"
                stroke-visible="false"
                ignore-layout="true"
                anchor-pos-x="63.5"
                anchor-pos-y="-14.35"
                preferred-width="6.7"
                preferred-height="6.7"
                size-delta="6.7 6.7"
                pad="0">
            <image id="exit-artwork"
                   ignore-layout="true"
                   anchor-min="0.5 0.5"
                   anchor-max="0.5 0.5"
                   anchored-position="0 0"
                   size-delta="6.7 6.7"
                   preserve-aspect="true" />
        </button>
    </horizontal>

    <horizontal id="difficulty-row"
                ignore-layout="true"
                preferred-width="112"
                preferred-height="12.65"
                pad-left="3"
                pad-right="3"
                spacing="1.5"
                child-control-width="false"
                child-control-height="false"
                child-expand-width="false"
                child-expand-height="false"
                child-align="MiddleCenter">
        <image id="difficulty-row-background"
               ignore-layout="true"
               anchor-min="0 0"
               anchor-max="1 1"
               anchored-position="0 0"
               size-delta="0 0" />
        <image id="difficulty-icon"
               src="BeatLocator.Assets.difficulty_icon.png"
               ignore-layout="true"
               preserve-aspect="true"
               size-delta="6 6" />
        <text id="difficulty-label"
              text="&lt;b&gt;DIFFICULTY&lt;/b&gt;&#10;&lt;size=70%&gt;&lt;color=#77889D&gt;How hard should it be?&lt;/color&gt;&lt;/size&gt;"
              align="MidlineLeft" font-size="3.2" word-wrap="false"
              preferred-width="29" preferred-height="8" size-delta="29 8" />
        <horizontal id="difficulty-options" preferred-width="73.4" preferred-height="6.9" spacing="0.6"
                    child-control-width="false" child-control-height="false"
                    child-expand-width="false" child-expand-height="false"
                    child-align="MiddleCenter">
            <button text="SUPER EASY" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="EASY" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="OKAY" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="A BIT HARD" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="E N D M E" preferred-width="14.2" preferred-height="6.9" pad="0" />
        </horizontal>
    </horizontal>

    <horizontal id="balance-row"
                ignore-layout="true"
                preferred-width="112"
                preferred-height="12.65"
                pad-left="3"
                pad-right="3"
                spacing="1.5"
                child-control-width="false"
                child-control-height="false"
                child-expand-width="false"
                child-expand-height="false"
                child-align="MiddleCenter">
        <image id="balance-row-background"
               ignore-layout="true"
               anchor-min="0 0"
               anchor-max="1 1"
               anchored-position="0 0"
               size-delta="0 0" />
        <image id="balance-icon"
               src="BeatLocator.Assets.balance_icon.png"
               ignore-layout="true"
               preserve-aspect="true"
               size-delta="6 6" />
        <text id="balance-label"
              text="&lt;b&gt;BALANCE&lt;/b&gt;&#10;&lt;size=70%&gt;&lt;color=#77889D&gt;What kind of map?&lt;/color&gt;&lt;/size&gt;"
              align="MidlineLeft" font-size="3.2" word-wrap="false"
              preferred-width="29" preferred-height="8" size-delta="29 8" />
        <horizontal id="balance-options" preferred-width="73.4" preferred-height="6.9" spacing="0.6"
                    child-control-width="false" child-control-height="false"
                    child-expand-width="false" child-expand-height="false"
                    child-align="MiddleCenter">
            <button text="T E C H" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="TECH" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="BALANCED" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="PASS" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="P A S S" preferred-width="14.2" preferred-height="6.9" pad="0" />
        </horizontal>
    </horizontal>

    <horizontal id="duration-row"
                ignore-layout="true"
                preferred-width="112"
                preferred-height="12.65"
                pad-left="3"
                pad-right="3"
                spacing="1.5"
                child-control-width="false"
                child-control-height="false"
                child-expand-width="false"
                child-expand-height="false"
                child-align="MiddleCenter">
        <image id="duration-row-background"
               ignore-layout="true"
               anchor-min="0 0"
               anchor-max="1 1"
               anchored-position="0 0"
               size-delta="0 0" />
        <image id="duration-icon"
               src="BeatLocator.Assets.duration_icon.png"
               ignore-layout="true"
               preserve-aspect="true"
               size-delta="6 6" />
        <text id="duration-label"
              text="&lt;b&gt;DURATION&lt;/b&gt;&#10;&lt;size=70%&gt;&lt;color=#77889D&gt;How long should it be?&lt;/color&gt;&lt;/size&gt;"
              align="MidlineLeft" font-size="3.2" word-wrap="false"
              preferred-width="29" preferred-height="8" size-delta="29 8" />
        <horizontal id="duration-options" preferred-width="73.4" preferred-height="6.9" spacing="0.6"
                    child-control-width="false" child-control-height="false"
                    child-expand-width="false" child-expand-height="false"
                    child-align="MiddleCenter">
            <button text="ANY" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="SHORT" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="SMALL" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="NORMAL" preferred-width="14.2" preferred-height="6.9" pad="0" />
            <button text="LONG" preferred-width="14.2" preferred-height="6.9" pad="0" />
        </horizontal>
    </horizontal>

    <horizontal id="modifier-options"
                ignore-layout="true"
                preferred-width="112"
                preferred-height="12.65"
                child-control-width="false"
                child-control-height="false"
                child-expand-width="false"
                child-expand-height="false"
                child-align="MiddleCenter">
        <button id="played-modifier-button"
                text=""
                stroke-visible="false"
                on-click="togglePlayed"
                preferred-height="12.65"
                pad="0">
            <image id="played-modifier-icon"
                   src="BeatLocator.Assets.played_by_me_icon.png"
                   ignore-layout="true"
                   preserve-aspect="true" />
            <text id="played-modifier-title"
                  text="PLAYED BY ME"
                  align="Left"
                  font-size="3"
                  word-wrap="false" />
            <text id="played-modifier-description"
                  text="Maps you've already played"
                  align="TopLeft"
                  font-size="2.1"
                  color="#8294A8"
                  word-wrap="true" />
        </button>
        <button id="two-saber-modifier-button"
                text=""
                stroke-visible="false"
                on-click="toggleTwoSaber"
                preferred-height="12.65"
                pad="0">
            <image id="two-saber-modifier-icon"
                   src="BeatLocator.Assets.two_saber_icon.png"
                   ignore-layout="true"
                   preserve-aspect="true" />
            <text id="two-saber-modifier-title"
                  text="TWO SABER ONLY"
                  align="Left"
                  font-size="3"
                  word-wrap="false" />
            <text id="two-saber-modifier-description"
                  text="Only maps with two sabers"
                  align="TopLeft"
                  font-size="2.1"
                  color="#8294A8"
                  word-wrap="true" />
        </button>
        <button id="secret-modifier-button"
                text=""
                stroke-visible="false"
                on-click="toggleSecretDifficulty"
                preferred-height="12.65"
                pad="0">
            <image id="secret-modifier-icon"
                   src="BeatLocator.Assets.secret_difficulty_icon.png"
                   ignore-layout="true"
                   preserve-aspect="true" />
            <text id="secret-modifier-title"
                  text="SECRET DIFFICULTY"
                  align="Left"
                  font-size="3"
                  word-wrap="false" />
            <text id="secret-modifier-description"
                  text="Song stars are now a mystery"
                  align="TopLeft"
                  font-size="2.1"
                  color="#8294A8"
                  word-wrap="true" />
        </button>
    </horizontal>

    <horizontal id="bot-speech-row"
                ignore-layout="true"
                preferred-width="112"
                preferred-height="12"
                child-control-width="false"
                child-control-height="false"
                child-expand-width="false"
                child-expand-height="false"
                child-align="MiddleCenter">
        <button id="bot-button"
                text=""
                stroke-visible="false"
                on-click="toggleBotSpeech"
                ignore-layout="true"
                preferred-width="11"
                preferred-height="11"
                pad="0">
            <image id="bot-artwork"
                   ignore-layout="true"
                   preserve-aspect="true" />
        </button>
        <image id="bot-speech-background"
               ignore-layout="true"
               preserve-aspect="false" />
        <text id="bot-speech-text"
              text=""
              ignore-layout="true"
              align="MidlineLeft"
              font-size="3"
              color="#FFFFFF"
              word-wrap="true" />
    </horizontal>

    <button id="find-button"
            text=""
            stroke-visible="false"
            on-click="findPressed"
            ignore-layout="true"
            preferred-width="112"
            preferred-height="11.5"
            pad="0">
        <image id="find-artwork"
               ignore-layout="true"
               preserve-aspect="false" />
    </button>
</vertical>
