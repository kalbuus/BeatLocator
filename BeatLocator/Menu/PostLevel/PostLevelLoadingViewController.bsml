<vertical id="loading-root"
          ignore-layout="true"
          anchor-min="0.5 0.5"
          anchor-max="0.5 0.5"
          anchored-position="0 -6"
          size-delta="80 28"
          child-control-width="true"
          child-control-height="true"
          child-expand-width="false"
          child-expand-height="false"
          child-align="MiddleCenter"
          spacing="1">
    <text text="~loadingText"
          align="Center"
          font-size="6"
          preferred-width="80"
          preferred-height="8" />
    <text text="~dotsText"
          align="Center"
          font-size="5"
          color="#A8A8A8"
          preferred-width="20"
          preferred-height="6" />
    <button id="cancel-button" text="CANCEL" on-click="cancel"
            ignore-layout="true"
            anchor-min="0.5 0.5" anchor-max="0.5 0.5"
            anchored-position="0 -11" size-delta="24 8"
            horizontal-fit="Unconstrained" vertical-fit="Unconstrained"
            min-width="24" preferred-width="24" flexible-width="0"
            min-height="8" preferred-height="8" flexible-height="0" />
</vertical>
