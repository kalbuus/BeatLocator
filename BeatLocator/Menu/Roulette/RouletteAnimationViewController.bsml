<vertical id="roulette-root" child-control-width="true" child-control-height="true" child-expand-width="false" child-expand-height="false" child-align="MiddleCenter" spacing="1">
    <horizontal id="roulette-viewport"
                bg="round-rect-panel"
                preferred-width="96"
                preferred-height="42"
                child-control-width="false"
                child-control-height="false"
                child-expand-width="false"
                child-expand-height="false">
        <vertical id="song-details"
                  active="false"
                  ignore-layout="true"
                  preferred-width="62"
                  preferred-height="36"
                  child-control-width="true"
                  child-control-height="true"
                  child-expand-width="false"
                  child-expand-height="false"
                  child-align="UpperLeft"
                  spacing="0.5">
            <horizontal id="song-title-row"
                        preferred-width="62"
                        preferred-height="6"
                        spacing="0"
                        child-control-width="true"
                        child-control-height="true"
                        child-expand-width="false"
                        child-expand-height="false"
                        child-align="MiddleLeft">
                <text id="song-title" text="~songTitleText" align="MidlineLeft" font-size="5.5" preferred-width="39" preferred-height="6" />
                <text id="song-sub-name" text="~songSubNameText" align="MidlineLeft" font-size="2.8" color="#888888" preferred-width="22" preferred-height="6" />
            </horizontal>
            <text id="song-author" text="~songAuthorText" align="Left" font-size="3.2" preferred-height="4.5" />
            <text id="song-mapper" text="~songMapperText" align="Left" font-size="3.2" preferred-height="4.5" />
            <text id="song-difficulty" text="~songDifficultyText" align="Left" font-size="3.2" preferred-height="7" />
            <horizontal id="song-actions" spacing="1" preferred-width="62" preferred-height="7"
                        child-control-width="true" child-control-height="true"
                        child-expand-width="false" child-expand-height="false">
                <button id="gameplay-settings-button" text="" on-click="gameplay-settings"
                        hover-hint="Settings &amp; modifiers"
                        preferred-width="7" preferred-height="7" flexible-width="0">
                    <image src="#SettingsIcon" ignore-layout="true" preserve-aspect="true"
                           anchor-min="0.5 0.5" anchor-max="0.5 0.5"
                           anchored-position="0 0" size-delta="3.5 3.5" raycast-target="false" />
                </button>
                <button id="menu-button" text="MENU" on-click="menuPressed" preferred-width="11" preferred-height="7" flexible-width="0" font-size="3" />
                <button id="skip-button" text="SKIP" on-click="skipPressed" preferred-width="11" preferred-height="7" flexible-width="0" font-size="3" />
                <button id="solo-button" text="~soloButtonText" on-click="soloPressed"
                        hover-hint="Open this map in Solo"
                        preferred-width="10" preferred-height="7" flexible-width="0" font-size="3" />
                <action-button id="primary-button" text="~primaryButtonText" on-click="primaryPressed" preferred-width="19" preferred-height="7" flexible-width="0" />
            </horizontal>
        </vertical>
    </horizontal>
    <button text="CANCEL" on-click="cancel-loading" active="~loadingInProgress"
            ignore-layout="true" anchor-pos-y="-31"
            preferred-width="38" preferred-height="8" />
</vertical>
